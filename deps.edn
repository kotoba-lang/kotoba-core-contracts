{:paths ["src" "resources" "." "scripts"]
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.edn, not clojure.edn. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       
        ;; kotoba.lang.text / kotoba.lang.coll, not clojure.string / clojure.set.
        ;; Pinned as explicit floors: tools.deps takes the NEWEST sha it is shown,
        ;; so without a floor this repo silently rides whatever a sibling names.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        io.github.kotoba-lang/coll {:git/sha "563f9e8911885170a2ffb44502c2f68764b9e0a9"}
       org.clojure/clojure {:mvn/version "1.12.4"}
        ;; Renamed upstream: kotoba-lang/dag-cbor is kotoba-lang/org-ietf-cbor.
        ;; The old name resolved only through GitHub's redirect; a redirect is
        ;; not a dependency declaration, so this pin went on working while
        ;; naming a repository that no longer exists, and nothing failed to say
        ;; so. 58144e81 is the same commit under either name -- the tree does
        ;; not change here, the name does. This file is where most of the fleet
        ;; first reaches the codec, so the old spelling propagated outward from
        ;; it; and tools.deps dedupes by the coordinate SYMBOL, so a consumer
        ;; that also names the new one ends up with two cbor.core at two shas.
        ;;
        ;; The :git/url is corrected and KEPT. Dropping it so that
        ;; io.github.<org>/<name> derives the URL would make the coordinate and
        ;; the repository incapable of disagreeing again, which is the tempting
        ;; fix -- but measured, it also deletes this dependency from what
        ;; scripts/verify-repository-roles.cljs sees: its production-deps keeps
        ;; only entries carrying a :git/url. resources/repository-rules.edn's
        ;; :depends-on, which that check asserts equal to production deps, is
        ;; updated in this commit for the same reason.
        io.github.kotoba-lang/org-ietf-cbor
        {:git/url "https://github.com/kotoba-lang/org-ietf-cbor.git"
         ;; 2026-09-25: a09268f8 (was 58144e81, which it contains): the
         ;; typed encoder definition-block-fragment is built on
         ;; (adr-2609242330 S1c).
         :git/sha "a09268f8227a8c9b1ce145fa57b244af2ebe7d5e"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         ;; 2026-09-25: 721281d2 (was eec3ee85, which it contains): moves with
         ;; cbor; the suite ran against it.
         :git/sha "721281d20525dc4d9af0064862d1c35226065ce2"}
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
         :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
