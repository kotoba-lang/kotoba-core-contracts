(ns kotoba.lang.package-contract
  {:kotoba/export #?(:kotoba [allowed-package-kinds cid? component-cid-error component-cid-of compute-manifest-cid contract-keyword? contract-surfaces-error contract-vector-error definition-cids-error invalid lock-required lockfile-error manifest-integrity-error manifest-required manifest-without-self-cid missing-key non-empty-string? package-manifest-error package-manifest-error-with-tree signatures-error tree-cid-error validate-case]
                     :default [allowed-package-kinds cid? component-cid-error component-cid-of compute-manifest-cid contract-keyword? contract-surfaces-error contract-vector-error definition-cids-error invalid lock-required lockfile-error manifest-integrity-error manifest-required manifest-without-self-cid missing-key non-empty-string? package-manifest-error signatures-error tree-cid-error validate-case])}
  (:require [kotoba.lang.text :as str]
            #?@(:kotoba [[kotoba.form :as form] [kotoba.bytes :as kbytes] [cbor.core :as cbor]
                         [multiformats.core :as mf] [ed25519.core :as ed25519]]
                :default [[kotoba.bytes :as kbytes] [cbor.core :as cbor]
                          [kotoba.lang.coll :as coll]
                          [multiformats.core :as mf]
                          [ed25519.core :as ed25519]]))
  ;; Kotoba: the dynamic value of a manifest / lock is the recursive `:form/r`
  ;; record of kotoba.form (the same schema, so the same type).
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

;; ── the Kotoba reading of this file ─────────────────────────────────────────
;; `#?(:kotoba A :default B)`: the Kotoba reader takes A, the JVM and
;; ClojureScript readers take B, so every host body below is what it was.
;; The Kotoba surface is the whole export list: the two scalar predicates
;; `non-empty-string?` and `cid?`, and -- restated over `kotoba.form`'s recursive
;; Form record, at the end of this file -- the manifest and lockfile validators
;; (maps whose shape is only known at run time) with their CBOR cid and Ed25519
;; checks. `cid?` reads the CID's bytes itself rather than through
;; `multiformats.core/cid->bytes`, which traps on a bad character where the
;; host catches its throw and answers false; a varint longer than nine groups
;; is false there (the host's shift wraps past 64 bits).

#?(:kotoba nil
   :default
(def manifest-required
  [:kotoba.package/name
   :kotoba.package/version
   :kotoba.package/repo-rid
   :kotoba.package/source
   :kotoba.package/capabilities
   :kotoba.package/signatures]))

#?(:kotoba nil
   :default
(def lock-required
  [:dep/name
   :dep/version
   :dep/repo-rid
   :dep/commit
   :dep/tree-cid
   :dep/manifest-cid
   :dep/signers
   :dep/capabilities]))

#?(:kotoba nil
   :default
(def allowed-package-kinds
  #{:library :adapter :schema-contract :tool :component}))

#?(:kotoba
(defn non-empty-string?
  [x :string] :bool
  (not (str/blank? x))))

#?(:kotoba nil
   :default
(defn non-empty-string?
  [x]
  (and (string? x) (not (str/blank? x)))))

#?(:kotoba nil
   :default
(defn- read-varint
  "Unsigned LEB128 varint at OFFSET in BS (any indexable byte sequence --
  `nth`/`count` work uniformly on a JVM byte-array and a ClojureScript
  vector, so this needs no platform-specific reader-conditional branch).
  Returns [value next-offset]."
  [bs offset]
  (loop [offset offset value 0 shift 0]
    (let [b (bit-and (nth bs offset) 0xff)]
      (if (< b 0x80)
        [(bit-or value (bit-shift-left b shift)) (inc offset)]
        (recur (inc offset) (bit-or value (bit-shift-left (bit-and b 0x7f) shift)) (+ shift 7)))))))

#?(:kotoba
(defn- b32-val [c :i64] :i64
  (cond (and (>= c 97) (<= c 122)) (- c 97)
        (and (>= c 50) (<= c 55)) (- c 24)
        :else -1)))

#?(:kotoba
(defn- b32-valid? [text :string from :i64] :bool
  (let [n (string-byte-length text)]
    (loop [i from]
      (cond (>= i n) true
            (< (b32-val (string-code-point-at text i)) 0) false
            :else (recur (+ i 1)))))))

#?(:kotoba
(defn- b32-decode [text :string from :i64] :vector-i64
  (let [n (string-byte-length text)]
    (loop [i from acc 0 bits 0 out (vector-i64)]
      (if (>= i n)
        out
        (let [acc2 (bit-or (i64-shift-left acc 5) (b32-val (string-code-point-at text i)))
              bits2 (+ bits 5)]
          (if (>= bits2 8)
            (let [bits3 (- bits2 8)]
              (recur (+ i 1)
                     (bit-and acc2 (- (i64-shift-left 1 bits3) 1))
                     bits3
                     (vector-conj out (bit-and 255 (i64-shift-right acc2 bits3)))))
            (recur (+ i 1) acc2 bits2 out))))))))

#?(:kotoba
(defn- varint-at
  "Unsigned LEB128 at OFFSET of BS as `[value next-offset]`; next is -1 if the
  bytes run out (or the run is longer than nine groups)."
  [bs :vector-i64 offset0 :i64] [:vector [:i64 :i64]]
  (loop [offset offset0 value 0 shift 0]
    (if (and (< offset (vector-count bs)) (< shift 64))
      (let [b (bit-and (vector-at bs offset) 255)]
        (if (< b 128)
          (hetero-vector [:vector [:i64 :i64]] (bit-or value (i64-shift-left b shift)) (+ offset 1))
          (recur (+ offset 1) (bit-or value (i64-shift-left (bit-and b 127) shift)) (+ shift 7))))
      (hetero-vector [:vector [:i64 :i64]] 0 -1)))))

#?(:kotoba
(defn- cid-fields? [bs :vector-i64] :bool
  (let [a (varint-at bs 0)
        off1 (hetero-vector-at [:vector [:i64 :i64]] a 1)]
    (and (>= off1 0)
         (let [b (varint-at bs off1)
               off2 (hetero-vector-at [:vector [:i64 :i64]] b 1)]
           (and (>= off2 0)
                (let [c (varint-at bs off2)
                      off3 (hetero-vector-at [:vector [:i64 :i64]] c 1)]
                  (and (>= off3 0)
                       (let [d (varint-at bs off3)
                             off4 (hetero-vector-at [:vector [:i64 :i64]] d 1)]
                         (and (>= off4 0)
                              (= 1 (hetero-vector-at [:vector [:i64 :i64]] a 0))
                              (> (hetero-vector-at [:vector [:i64 :i64]] b 0) 0)
                              (> (hetero-vector-at [:vector [:i64 :i64]] c 0) 0)
                              (> (hetero-vector-at [:vector [:i64 :i64]] d 0) 0)
                              (= (hetero-vector-at [:vector [:i64 :i64]] d 0)
                                 (- (vector-count bs) off4))))))))))))

#?(:kotoba
(defn cid?
  "A genuine CIDv1 structural check: base32 'b' multibase, then
  [version-varint][codec-varint][multihash: fn-varint len-varint digest], the
  version 1 and the declared multihash length the decoded digest's byte count."
  [x :string] :bool
  (and (non-empty-string? x)
       (= 98 (string-code-point-at x 0))
       (> (string-byte-length x) 1)
       (b32-valid? x 1)
       (cid-fields? (b32-decode x 1)))))

#?(:kotoba nil
   :default
(defn cid?
  "A genuine CIDv1 structural check (`multiformats.core/cid->bytes` decode,
  then parse [version-varint][codec-varint][multihash: fn-varint
  len-varint digest]) -- not the previous `(str/starts-with? x \"bafy\")`
  prefix sniff, which never actually decoded anything and happily accepted
  strings containing characters (`0`/`1`/`8`/`9`, e.g. this repo's own
  former test fixtures like \"bafyrepojson111...\") that fall OUTSIDE the
  base32 'b'-multibase alphabet and could never have decoded as a real
  CID. Requires version 1 (the only version `multiformats.core/cidv1`
  emits) and the multihash's declared length to actually match the
  decoded digest's byte count -- a truncated or padded string fails here
  even if the multibase alphabet and varint framing otherwise parse."
  [x]
  (and (non-empty-string? x)
       (str/starts-with? x "b")
       (try
         (let [bs (mf/cid->bytes x)
               [version off1] (read-varint bs 0)
               [codec off2] (read-varint bs off1)
               [hash-fn off3] (read-varint bs off2)
               [hash-len off4] (read-varint bs off3)
               digest-len (- (count bs) off4)]
           (and (= 1 version)
                (pos? codec)
                (pos? hash-fn)
                (pos? hash-len)
                (= hash-len digest-len)))
         (catch #?(:clj Exception :cljs :default) _ false)))))

#?(:kotoba nil
   :default
(defn invalid
  [message data]
  {:valid? false :message message :data data}))

#?(:kotoba nil
   :default
(defn contract-keyword?
  [x]
  (and (keyword? x)
       (let [s (subs (str x) 1)]
         (or (str/starts-with? s "app.kotoba.")
             (str/starts-with? s "wire.kotoba."))))))

#?(:kotoba nil
   :default
(defn missing-key
  [m keys message]
  (some (fn [k] (when-not (contains? m k) (invalid message {:missing k}))) keys)))

#?(:kotoba nil
   :default
(defn contract-vector-error
  [value field]
  (cond
    (and (some? value) (not (vector? value)))
    (invalid "contract surface vector required" {:field field :value value})

    :else
    (some (fn [contract]
            (when-not (contract-keyword? contract)
              (invalid "contract surface keyword required"
                       {:field field :value contract})))
          value))))

#?(:kotoba nil
   :default
(defn definition-cids-error
  "A dep may pin the exact definitions it resolved against, not just the tree
  and manifest it came from. :dep/tree-cid says \"this is the source I built
  against\"; :dep/definition-cids says \"and these are the definitions inside
  it I actually bound to\", so a republish that keeps the tree but swaps a
  definition body is caught rather than silently accepted.

  Optional -- omitting the key is valid, and every dep in the corpus that
  predates it stays valid. When present it must be a vector of syntactically
  valid CIDs with no repeats: a duplicate is either a lock generator bug or an
  attempt to pad the list so a diff of it looks unchanged, and neither should
  be admitted quietly."
  [value field]
  (cond
    (nil? value) nil

    (not (vector? value))
    (invalid "definition cids must be a unique CID vector"
             {:field field :value value :reason :not-a-vector})

    :else
    (or (some (fn [c]
                (when-not (cid? c)
                  (invalid "definition cids must be a unique CID vector"
                           {:field field :value c :reason :not-a-cid})))
              value)
        (when-not (= (count value) (count (set value)))
          (invalid "definition cids must be a unique CID vector"
                   {:field field :value value :reason :duplicate}))))))

#?(:kotoba nil
   :default
(defn contract-surfaces-error
  [m prefix]
  (or (contract-vector-error (get m (keyword prefix "provides"))
                             (keyword prefix "provides"))
      (contract-vector-error (get m (keyword prefix "consumes"))
                             (keyword prefix "consumes")))))

#?(:kotoba nil
   :default
(defn- signed-bytes
  "UTF-8 bytes of S. Used to turn the canonical string a package signature
  attests to (its manifest's own declared :manifest-cid -- see
  `signatures-error`) into the byte message Ed25519 verify operates on.
  Portable (same #?(:cljs (.encode (js/TextEncoder.) s)) construction
  `multiformats.core/kotoba-cid` already uses in this dependency)."
  [^String s]
  #?(:clj (kbytes/utf8-bytes s)
     :cljs (.encode (js/TextEncoder.) s))))

#?(:kotoba nil
   :default
(defn- base64->bytes
  "Decode a base64 signature into the byte shape `ed25519.core/verify` takes on
  this host. Throws on input the host's decoder rejects; callers treat that the
  same as a signature that did not verify."
  [^String sig]
  #?(:clj (kbytes/base64-decode-bytes ^String sig)
     :cljs (js/Buffer.from sig "base64"))))

#?(:kotoba nil
   :default
(defn- ed25519-signature-error
  "Real Ed25519 verification of SIG (a base64-encoded signature, the same
  encoding `cacao.core`/`kotoba-lang/org-chainagnostic-cacao` uses) against
  SIGNED bytes, under the public key encoded in DID (a did:key:z... string,
  `ed25519.core/did-key->pubkey`). nil when the signature verifies; a
  package-contract-shaped error otherwise. Never throws: bad base64, a
  malformed did:key, or a genuine signature mismatch are all reported as
  the same closed rejection, not an uncaught exception.

  PORTABLE as of 2026-09-06. It was `:clj`-only, and its own docstring gave
  the reason: \"no portable/:cljs Ed25519 verifier exists yet anywhere in this
  dependency graph\". That was true when written and is not true now --
  `kotoba-lang/org-ietf-ed25519` carries a `:cljs` branch over `node:crypto`,
  and this repository already depends on it. Measured before changing
  anything: `(ed25519.core/verify-did did msg sig)` returns `true` under nbb
  for a signature this same runtime produced.

  The `:cljs` branch used to fail CLOSED -- every signature rejected -- which
  was the right call while nothing could verify one, and is the wrong call
  once something can. It rejected VALID signatures, so the failure was not
  visible as a security hole; it was visible as \"package locks cannot be
  consumed off the JVM at all\", which is what kept `amu` from consuming one.
  Reproduce the old behaviour by deleting the `ed25519.core` require: every
  accepting vector in `kotoba.lang.package-signature-test` (JVM) and in
  `test/run_portable.cljk` (Node) flips to rejected, and the forged ones
  start being rejected for the WRONG reason -- which is what makes the
  reason literal those suites pin worth pinning."
  [sig did signed]
  (try
    (when-not (ed25519/verify-did did signed (base64->bytes sig))
      (invalid "signature verification failed" {:did did}))
    (catch #?(:clj Exception :cljs :default) e
      (invalid "signature verification failed"
               ;; 2026-09-12, adr-2609111900: the `:default` clause below exists so the
               ;; Kotoba reader, whose only feature is `:kotoba`, reads this file. A
               ;; `#?(:clj a :cljs b)` with no matching feature reads as NOTHING, which in a
               ;; map-value position leaves the map with an odd number of forms, so the whole
               ;; file was refused at read time ("map literal must contain an even number of
               ;; forms") -- in a dependency, so every dependant stopped here. With `:default`
               ;; the reader reads the file and refuses the `:cljs` form by NAME later, in the
               ;; module that uses it. It changes nothing on clj/cljs: Clojure still picks
               ;; `:clj`, ClojureScript/nbb still picks `:cljs` (first match).
               {:did did :error #?(:clj (.getMessage ^Exception e)
                                   :cljs (.-message e)
                                   :default (.-message e))})))))

#?(:kotoba nil
   :default
(defn signatures-error
  "Validates SIGS (a package manifest's :kotoba.package/signatures vector)
  for shape AND for real Ed25519 cryptographic authenticity: each
  signature's :sig must actually verify, under the Ed25519 public key
  encoded in its own :did, against MANIFEST-CID (the manifest's own
  declared :kotoba.package/source :manifest-cid -- the content-identifier
  every signer and verifier can derive from the manifest without agreeing
  on a byte-for-byte re-encoding here; `kotoba.package-admission/
  manifest-integrity-error` in the sibling kotoba-lang/kotoba repo
  separately verifies that CID actually matches the manifest's real
  content, so the two checks compose into signer-attests-to-CID +
  CID-matches-content).

  Before this fix, this function only checked shape (non-blank :did/:sig
  strings, :alg = :ed25519) and never called any verification -- ANY :sig
  string under ANY :did passed (docs/issues/
  security-package-contract-conformance-gap.md, F-001). A forged or
  malformed signature -- wrong key, tampered bytes, garbage :sig, a :did
  that never actually signed this manifest -- now fails closed (rejected),
  not silently accepted."
  [sigs manifest-cid]
  (cond
    (empty? sigs) (invalid "signature required" {})
    :else
    (some (fn [sig]
            (or (missing-key sig [:did :alg :sig] "signature missing required field")
                (when-not (non-empty-string? (:did sig))
                  (invalid "signature did required" {:signature sig}))
                (when-not (= :ed25519 (:alg sig))
                  (invalid "signature alg unsupported" {:signature sig}))
                (when-not (non-empty-string? (:sig sig))
                  (invalid "signature bytes required" {:signature sig}))
                (ed25519-signature-error (:sig sig) (:did sig) (signed-bytes manifest-cid))))
          sigs))))

#?(:kotoba nil
   :default
(defn manifest-without-self-cid
  "MANIFEST with its own self-declared `:manifest-cid` removed, AND its
  `:kotoba.package/signatures` removed. Both are content a manifest's CID is
  computed OVER TOP OF, never included IN.

  `:manifest-cid`'s exclusion is the obvious case -- for the same reason a
  Git commit id never covers itself. `:signatures`' exclusion is forced by
  `signatures-error` doing real verification: a signer's `:sig` attests to
  this manifest's `:manifest-cid`, so if the CID also covered `:signatures`,
  a self-consistent manifest would require solving a circular fixed point.
  Excluding signatures breaks the cycle: the CID is a pure function of the
  substantive fields, computed once, then signed, and signatures can be added
  or rotated afterwards without changing what the CID covers.

  KNOWN LIMITATION, carried over verbatim from the `.clj` original because it
  is a property of the design and not of the port: since `:manifest-cid` does
  not cover `:signatures`, the CID cannot bind WHICH or HOW MANY signers
  vouched for this content. `signatures-error` verifies that every signature
  PRESENT is individually valid; nothing requires a minimum count, a quorum,
  or membership in an authorised set, so a manifest with one legitimate
  co-signer's entry silently removed (CID untouched) still passes. An n-of-m
  policy needs its own binding mechanism independent of `:manifest-cid`."
  [manifest]
  (-> manifest
      (update :kotoba.package/source dissoc :manifest-cid)
      (dissoc :kotoba.package/signatures))))

#?(:kotoba nil
   :default
(defn compute-manifest-cid
  "The real CIDv1 (canonical DAG-CBOR + sha2-256) of MANIFEST's actual
  content, excluding its own self-declared `:manifest-cid`."
  [manifest]
  (mf/cidv1-dag-cbor (cbor/encode (manifest-without-self-cid manifest)))))

#?(:kotoba nil
   :default
(defn manifest-integrity-error
  "nil if MANIFEST's self-declared `:manifest-cid` matches what its content
  actually hashes to; a contract-shaped error otherwise.

  This closes the gap `package-manifest-error` names in its own docstring: on
  its own, that function binds a valid signature to the manifest's SELF-
  DECLARED `:manifest-cid`, so a manifest whose other fields were mutated
  after signing -- with `:manifest-cid` left untouched -- still passes. The
  two compose into signer-attests-to-CID plus CID-matches-content; neither
  alone is a content binding.

  PORTABLE, and here rather than in the file-I/O layer, because a manifest's
  subject IS the in-memory manifest. That is what separates it from
  `tree-cid-error`, whose subject -- an actual source tree -- is not part of
  the data this kernel receives and therefore cannot be recomputed here.

  It was available only under `:clj`, in `kotoba.security.package-admission`,
  which is why a Node consumer of a package lock could check a signature but
  not what the signature was over. `kotoba.compiler.nbb.package-lock` calls
  this."
  [manifest]
  (let [declared (get-in manifest [:kotoba.package/source :manifest-cid])]
    (when (cid? declared)
      (let [computed (compute-manifest-cid manifest)]
        (when (not= declared computed)
          (invalid "manifest cid does not match manifest content"
                   {:declared declared :computed computed})))))))

#?(:kotoba nil
   :default
(defn tree-cid-error
  "Real content-integrity check for a source tree -- the :tree-cid analogue
  of `kotoba.package-admission/manifest-integrity-error` (kotoba-lang/kotoba,
  which recomputes and compares :manifest-cid from a manifest's own EDN
  content). Computes `multiformats.core/cidv1-raw` of TREE-BYTES -- the
  caller-supplied REAL byte content of the source tree DECLARED is supposed
  to pin -- and compares. nil when they match; a package-contract-shaped
  error otherwise (fails closed on mismatch).

  This .cljc kernel is deliberately I/O-free (`package-manifest-error` /
  `lockfile-error` validate only already-parsed EDN, never touch a
  filesystem or a git object store). Unlike :manifest-cid, whose subject
  (the manifest's own EDN data) IS already an in-memory argument to
  `package-manifest-error`, :tree-cid's subject -- an actual source tree /
  git working tree -- is NOT part of the manifest/lock data this kernel
  receives at all. TREE-BYTES must therefore come from a caller that
  genuinely has filesystem/git access (this mirrors why
  manifest-integrity-error itself lives outside this kernel, in a separate
  file-I/O-capable layer, one repo over). `package-manifest-error` /
  `lockfile-error` accept optional tree content (`:tree-bytes` /
  `:tree-bytes-by-dep`) and call this when it is supplied; when it is not
  supplied (every existing caller and fixture, unchanged) they still only
  run the shape-only `cid?` check they always ran -- this function never
  silently no-ops a check by treating absent content as a pass."
  [declared tree-bytes]
  (cond
    (not (cid? declared)) (invalid "tree cid required" {:value declared})
    (nil? tree-bytes) (invalid "tree content required to verify tree cid" {:declared declared})
    :else
    (let [computed (mf/cidv1-raw tree-bytes)]
      (when (not= declared computed)
        (invalid "tree cid does not match tree content"
                 {:declared declared :computed computed}))))))

#?(:kotoba nil
   :default
(defn component-cid-of
  "Extract the component CID pin from a lock entry or package build map.
  Accepts either top-level `:dep/component-cid` / `:kotoba.package/component-cid`
  or nested `:dep/build` / `:kotoba.package/build` `:component-cid` (ADR
  package-cid-lock optional field; required for :component kind on L3)."
  [m]
  (or (:dep/component-cid m)
      (:kotoba.package/component-cid m)
      (get-in m [:dep/build :component-cid])
      (get-in m [:kotoba.package/build :component-cid])
      (when (map? (:dep/build m))
        (get (:dep/build m) :component-cid))
      (when (map? (:kotoba.package/build m))
        (get (:kotoba.package/build m) :component-cid)))))

#?(:kotoba nil
   :default
(defn component-cid-error
  "Shape (+ optional content) check for a component CID pin.
  When COMPONENT-BYTES is supplied, recomputes CIDv1-raw and rejects
  mismatch — same integrity pattern as tree-cid-error (L3 guest packages)."
  ([declared] (component-cid-error declared nil))
  ([declared component-bytes]
   (cond
     (not (cid? declared))
     (invalid "component cid required" {:value declared})

     (nil? component-bytes)
     nil

     :else
     (let [computed (mf/cidv1-raw component-bytes)]
       (when (not= declared computed)
         (invalid "component cid does not match component content"
                  {:declared declared :computed computed})))))))

#?(:kotoba nil
   :default
(defn- lock-dep-component-error
  "For :component kind packages, a component-cid pin is mandatory (L3).
  For any kind, a present component-cid must be a real CIDv1. Optional
  content integrity when COMPONENT-BYTES is supplied."
  [dep component-bytes]
  (let [kind (:dep/kind dep)
        declared (component-cid-of dep)]
    (cond
      (and (= :component kind) (nil? declared))
      (invalid "component cid required"
               {:dependency (:dep/name dep) :kind kind})

      (some? declared)
      (component-cid-error declared component-bytes)

      :else nil))))

#?(:kotoba nil
   :default
(defn package-manifest-error
  "2-arity OPTS may carry :tree-bytes -- see `tree-cid-error` -- to also
  recompute-and-compare :tree-cid against real content; omitted (the
  1-arity, every existing caller) keeps the original shape-only :tree-cid
  behavior unchanged.

  IMPORTANT (see `signatures-error`'s docstring): this function alone binds
  a valid signature to the manifest's self-declared :manifest-cid field,
  NOT to the manifest's actual content -- a manifest whose other fields
  (:kotoba.package/capabilities, :name, :version, ...) are mutated AFTER
  signing, with :manifest-cid left untouched, still passes this function.
  It only becomes a genuine content-binding guarantee when composed with a
  SEPARATE check that recomputes :manifest-cid from the manifest's real
  content and rejects a mismatch -- `kotoba.package-admission/verify-lock`
  in the sibling kotoba-lang/kotoba repo does exactly that (calling both
  this function AND `manifest-integrity-error`). A caller using THIS
  function in isolation does not get that guarantee; see
  `manifest-content-tampering-slips-through-manifest-error-alone` in this
  namespace's tests for a concrete demonstration."
  ([m] (package-manifest-error m nil))
  ([m {:keys [tree-bytes]}]
   (let [source (:kotoba.package/source m)]
     (or
      (missing-key m manifest-required "missing required package field")
      (when (and (:kotoba.package/kind m)
                 (not (contains? allowed-package-kinds (:kotoba.package/kind m))))
        (invalid "unknown package kind"
                 {:package (:kotoba.package/name m)
                  :allowed allowed-package-kinds}))
      (contract-surfaces-error m "kotoba.package")
      (when (and (= :adapter (:kotoba.package/kind m))
                 (empty? (:kotoba.package/consumes m)))
        (invalid "adapter consumes required" {:package (:kotoba.package/name m)}))
      (when (and (= :schema-contract (:kotoba.package/kind m))
                 (empty? (:kotoba.package/provides m)))
        (invalid "schema-contract provides required" {:package (:kotoba.package/name m)}))
      (when-not (cid? (:kotoba.package/repo-rid m))
        (invalid "repo-rid cid required" {:value (:kotoba.package/repo-rid m)}))
      (missing-key source [:git-commit :tree-cid :manifest-cid] "missing required source field")
      (when-not (cid? (:tree-cid source))
        (invalid "tree cid required" {:source source}))
      (when tree-bytes (tree-cid-error (:tree-cid source) tree-bytes))
      (when-not (cid? (:manifest-cid source))
        (invalid "manifest cid required" {:source source}))
      (when-not (vector? (:kotoba.package/capabilities m))
        (invalid "capabilities vector required" {:value (:kotoba.package/capabilities m)}))
      (signatures-error (:kotoba.package/signatures m) (:manifest-cid source)))))))

#?(:kotoba nil
   :default
(defn lockfile-error
  "3-arity OPTS may carry :tree-bytes-by-dep -- {dep-name tree-bytes ...} --
  to also recompute-and-compare each dep's :dep/tree-cid against real
  content (see `tree-cid-error`); omitted (the 2-arity, every existing
  caller) keeps the original shape-only :dep/tree-cid behavior unchanged.

  OPTS may also carry :component-bytes-by-dep -- {dep-name component-bytes}
  -- for L3 component-cid content integrity (CID guest packages)."
  ([m tc] (lockfile-error m tc nil))
  ([m tc {:keys [tree-bytes-by-dep component-bytes-by-dep]}]
   (let [declared (set (:declared-capabilities tc))
         blocked (coll/set-union (set (:revoked-signers tc))
                            (set (:expired-signers tc))
                            (set (:compromised-signers tc)))]
     (or
      (when-not (= 1 (:kotoba.lock/version m))
        (invalid "lock version 1 required" {:value (:kotoba.lock/version m)}))
      (when-not (vector? (:deps m))
        (invalid "lock deps vector required" {:value (:deps m)}))
      (some (fn [dep]
              (or (missing-key dep lock-required "missing required lock field")
                  (when (and (:dep/kind dep)
                             (not (contains? allowed-package-kinds (:dep/kind dep))))
                    (invalid "unknown package kind" {:dependency (:dep/name dep)}))
                  (contract-surfaces-error dep "dep")
                  (some (fn [k]
                          (when-not (cid? (get dep k))
                            (invalid "cid required" {:field k :value (get dep k)})))
                        [:dep/repo-rid :dep/tree-cid :dep/manifest-cid])
                  (definition-cids-error (:dep/definition-cids dep)
                                         :dep/definition-cids)
                  (when-let [tree-bytes (get tree-bytes-by-dep (:dep/name dep))]
                    (tree-cid-error (:dep/tree-cid dep) tree-bytes))
                  (lock-dep-component-error
                   dep (get component-bytes-by-dep (:dep/name dep)))
                  (when-not (seq (:dep/signers dep))
                    (invalid "signer required" {:dep dep}))
                  (when-let [bad (seq (coll/set-intersection (set (:dep/signers dep)) blocked))]
                    (invalid "signer not currently trusted"
                             {:signers (vec bad)
                              :dependency (:dep/name dep)}))
                  (when-not (coll/subset? (set (:dep/capabilities dep)) declared)
                    (invalid "capability grant exceeds package declaration"
                             {:grant (:dep/capabilities dep)
                              :declared (:declared-capabilities tc)}))))
            (:deps m)))))))

#?(:kotoba nil
   :default
(defn validate-case
  [tc data]
  (let [result (case (:type tc)
                 :package-manifest (package-manifest-error data)
                 :lockfile (lockfile-error data tc)
                 (invalid "unknown case type" tc))]
    (if result result {:valid? true}))))

;; ── the Kotoba reading of the manifest and lock validators ──────────────────
;; Everything below exists on the Kotoba route only (`#?(:kotoba ...)`, dropped
;; by the host readers), and is the host code above restated over `kotoba.form`'s
;; recursive Form record -- the one value type that carries a manifest or a lock
;; (maps of unknown shape, nested without bound). A host `nil` is `(form/nil-form)`:
;; an ERROR RESULT is a Form map `{:valid? false :message .. :data ..}` and "no
;; error" is the nil Form, so a caller tests `(form/is-nil? e)` where the host
;; tests `when-let`. `(get m k)` on anything that is not a map answers nil, as
;; `(:k x)` does on the host.
;;
;; Where it differs, each measured against the host body above:
;;   * optional byte arguments are `[:option :vector-i64]` (the host's nil/bytes);
;;     the opts map of the 3-arity `lockfile-error` is a Form map whose
;;     per-dependency values are Form bytes leaves (`form/bytes-form`);
;;   * the 2-arity `package-manifest-error` is `package-manifest-error-with-tree`;
;;   * `:allowed` (a set) lists the five kinds in a fixed order, and `:signers`
;;     of the untrusted-signer error lists them in the lock's order, deduplicated;
;;     the host's order is its hash order;
;;   * the `:error` datum of a signature that does not verify is a fixed phrase
;;     (the host puts the exception's message there);
;;   * a `:kotoba.package/signatures` that is neither a vector, list nor set is
;;     "signature required" where the host would throw;
;;   * the signature is decoded with `kotoba.bytes/base64-decode-bytes` (the
;;     JDK's strict decoder, as the host), the message is the UTF-8 bytes of the
;;     manifest cid, and the proof is `ed25519.core/verify-did`;
;;   * `compute-manifest-cid` is `cbor/encode-form` over the manifest without its
;;     self cid and signatures, which traps on a set or symbol leaf (the host
;;     encoder has no such leaf either for a manifest read from EDN).

#?(:kotoba
(defn- kwf [k :keyword] [:ref :form/r] (form/keyword-form k)))

#?(:kotoba
(defn- gk [m [:ref :form/r] k :keyword] [:ref :form/r]
  (if (form/is-map? m) (form/form-get m (form/keyword-form k)) (form/nil-form))))

#?(:kotoba
(defn- has-k? [m [:ref :form/r] k :keyword] :bool
  (and (form/is-map? m) (form/form-has? m (form/keyword-form k)))))

#?(:kotoba
(defn- lookup [m [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
  (if (form/is-map? m) (form/form-get m k) (form/nil-form))))

;; `some?`-and-not-false: what `or` / `when` / `when-let` treat as present.
#?(:kotoba
(defn- truthy? [x [:ref :form/r]] :bool
  (not (or (form/is-nil? x)
           (and (form/is-bool? x) (not (form/bool-value x)))))))

#?(:kotoba
(defn- empty-form? [x [:ref :form/r]] :bool
  (cond (form/is-nil? x) true
        (form/is-string? x) (= 0 (string-byte-length (form/string-value x)))
        (or (form/is-seq? x) (form/is-vec? x) (form/is-set? x) (form/is-map? x)) (= 0 (form/count-of x))
        :else false)))

#?(:kotoba
(defn- map1 [k1 :keyword v1 [:ref :form/r]] [:ref :form/r]
  (form/form-map (form/two-forms (form/keyword-form k1) v1))))

#?(:kotoba
(defn- map2 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r]] [:ref :form/r]
  (form/form-map (typed-list-new [:list [:ref :form/r]]
                                 (form/keyword-form k1) v1 (form/keyword-form k2) v2))))

#?(:kotoba
(defn invalid [message :string data [:ref :form/r]] [:ref :form/r]
  (form/form-map (typed-list-new [:list [:ref :form/r]]
                                 (form/keyword-form :valid?) (form/bool-form false)
                                 (form/keyword-form :message) (form/string-form message)
                                 (form/keyword-form :data) data))))

#?(:kotoba
(defn manifest-required [] [:ref :form/r]
  (form/form-vec (typed-list-new [:list [:ref :form/r]]
                                 (kwf :kotoba.package/name) (kwf :kotoba.package/version)
                                 (kwf :kotoba.package/repo-rid) (kwf :kotoba.package/source)
                                 (kwf :kotoba.package/capabilities) (kwf :kotoba.package/signatures)))))

#?(:kotoba
(defn lock-required [] [:ref :form/r]
  (form/form-vec (typed-list-new [:list [:ref :form/r]]
                                 (kwf :dep/name) (kwf :dep/version) (kwf :dep/repo-rid)
                                 (kwf :dep/commit) (kwf :dep/tree-cid) (kwf :dep/manifest-cid)
                                 (kwf :dep/signers) (kwf :dep/capabilities)))))

#?(:kotoba
(defn allowed-package-kinds [] [:ref :form/r]
  (form/form-set (typed-list-new [:list [:ref :form/r]]
                                 (kwf :library) (kwf :adapter) (kwf :schema-contract)
                                 (kwf :tool) (kwf :component)))))

#?(:kotoba
(defn- has-member? [xs [:ref :form/r] x [:ref :form/r]] :bool
  (let [n (form/count-of xs)]
    (loop [i 0]
      (if (>= i n)
        false
        (if (form/eq (form/nth-of xs i) x) true (recur (+ i 1))))))))

#?(:kotoba
(defn- allowed-kind? [k [:ref :form/r]] :bool
  (has-member? (allowed-package-kinds) k)))

;; The EDN text of a keyword without its colon, namespace included
;; (`(subs (str k) 1)`).
#?(:kotoba
(defn- keyword-text [k [:ref :form/r]] :string
  (let [s (document-edn-print (document-keyword (form/keyword-value k)))]
    (string-substring s 1 (string-byte-length s)))))

#?(:kotoba
(defn contract-keyword? [x [:ref :form/r]] :bool
  (and (form/is-keyword? x)
       (let [s (keyword-text x)]
         (or (str/starts-with? s "app.kotoba.")
             (str/starts-with? s "wire.kotoba."))))))

#?(:kotoba
(defn- cid-form? [x [:ref :form/r]] :bool
  (and (form/is-string? x) (cid? (form/string-value x)))))

#?(:kotoba
(defn- nonblank-form? [x [:ref :form/r]] :bool
  (and (form/is-string? x) (non-empty-string? (form/string-value x)))))

#?(:kotoba
(defn missing-key [m [:ref :form/r] ks [:ref :form/r] message :string] [:ref :form/r]
  (let [n (form/count-of ks)]
    (loop [i 0]
      (if (>= i n)
        (form/nil-form)
        (let [k (form/nth-of ks i)]
          (if (and (form/is-map? m) (form/form-has? m k))
            (recur (+ i 1))
            (invalid message (map1 :missing k)))))))))

#?(:kotoba
(defn contract-vector-error [value [:ref :form/r] field [:ref :form/r]] [:ref :form/r]
  (if (and (not (form/is-nil? value)) (not (form/is-vec? value)))
    (invalid "contract surface vector required" (map2 :field field :value value))
    (let [n (form/count-of value)]
      (loop [i 0]
        (if (>= i n)
          (form/nil-form)
          (let [c (form/nth-of value i)]
            (if (contract-keyword? c)
              (recur (+ i 1))
              (invalid "contract surface keyword required" (map2 :field field :value c))))))))))

#?(:kotoba
(defn contract-surfaces-error [m [:ref :form/r] prefix :string] [:ref :form/r]
  (let [pk (keyword-from-string (str prefix "/provides"))
        ck (keyword-from-string (str prefix "/consumes"))
        e1 (contract-vector-error (gk m pk) (form/keyword-form pk))]
    (if (form/is-nil? e1)
      (contract-vector-error (gk m ck) (form/keyword-form ck))
      e1))))

;; Is there an item of XS, before index I, equal to the item at I?
#?(:kotoba
(defn- dup-before? [xs [:ref :form/r] i :i64] :bool
  (let [x (form/nth-of xs i)]
    (loop [j 0]
      (if (>= j i)
        false
        (if (form/eq (form/nth-of xs j) x) true (recur (+ j 1))))))))

#?(:kotoba
(defn- has-dup? [xs [:ref :form/r]] :bool
  (let [n (form/count-of xs)]
    (loop [i 1]
      (if (>= i n)
        false
        (if (dup-before? xs i) true (recur (+ i 1))))))))

#?(:kotoba
(defn- first-non-cid [xs [:ref :form/r]] [:ref :form/r]
  (let [n (form/count-of xs)]
    (loop [i 0]
      (if (>= i n)
        (form/nil-form)
        (if (cid-form? (form/nth-of xs i)) (recur (+ i 1)) (form/nth-of xs i)))))))

#?(:kotoba
(defn- not-a-cid-index [xs [:ref :form/r]] :i64
  (let [n (form/count-of xs)]
    (loop [i 0]
      (if (>= i n)
        -1
        (if (cid-form? (form/nth-of xs i)) (recur (+ i 1)) i))))))

#?(:kotoba
(defn definition-cids-error [value [:ref :form/r] field [:ref :form/r]] [:ref :form/r]
  (cond
    (form/is-nil? value) (form/nil-form)
    (not (form/is-vec? value))
    (invalid "definition cids must be a unique CID vector"
             (form/form-map (typed-list-new [:list [:ref :form/r]]
                                            (kwf :field) field (kwf :value) value
                                            (kwf :reason) (kwf :not-a-vector))))
    :else
    (let [bad (not-a-cid-index value)]
      (if (>= bad 0)
        (invalid "definition cids must be a unique CID vector"
                 (form/form-map (typed-list-new [:list [:ref :form/r]]
                                                (kwf :field) field (kwf :value) (form/nth-of value bad)
                                                (kwf :reason) (kwf :not-a-cid))))
        (if (has-dup? value)
          (invalid "definition cids must be a unique CID vector"
                   (form/form-map (typed-list-new [:list [:ref :form/r]]
                                                  (kwf :field) field (kwf :value) value
                                                  (kwf :reason) (kwf :duplicate))))
          (form/nil-form)))))))

;; ---- signatures ----------------------------------------------------------

#?(:kotoba
(defn- did-error [did :string reason :string] [:ref :form/r]
  (invalid "signature verification failed"
           (map2 :did (form/string-form did) :error (form/string-form reason)))))

;; nil when SIG (base64) is a signature of SIGNED under the key of DID.
#?(:kotoba
(defn- ed25519-signature-error [sig :string did :string signed :vector-i64] [:ref :form/r]
  (let [raw (kbytes/base64-decode-bytes sig)]
    (if (option-some?-of [:option :bytes] raw)
      (let [v (ed25519/verify-did did signed
                                  (vector-i64-from-bytes
                                   (option-value-of [:option :bytes] raw (bytes-empty))))]
        (if (option-some?-of [:option :bool] v)
          (if (option-value-of [:option :bool] v false)
            (form/nil-form)
            (invalid "signature verification failed" (map1 :did (form/string-form did))))
          (did-error did "malformed did:key")))
      (did-error did "illegal base64")))))

#?(:kotoba
(defn- sig-keys [] [:ref :form/r]
  (form/form-vec (typed-list-new [:list [:ref :form/r]] (kwf :did) (kwf :alg) (kwf :sig)))))

#?(:kotoba
(defn- one-signature-error [sig [:ref :form/r] signed :vector-i64] [:ref :form/r]
  (let [e (missing-key sig (sig-keys) "signature missing required field")]
    (cond
      (not (form/is-nil? e)) e
      (not (nonblank-form? (gk sig :did))) (invalid "signature did required" (map1 :signature sig))
      (not (form/eq (gk sig :alg) (kwf :ed25519))) (invalid "signature alg unsupported" (map1 :signature sig))
      (not (nonblank-form? (gk sig :sig))) (invalid "signature bytes required" (map1 :signature sig))
      :else (ed25519-signature-error (form/string-value (gk sig :sig))
                                     (form/string-value (gk sig :did))
                                     signed)))))

#?(:kotoba
(defn signatures-error [sigs [:ref :form/r] manifest-cid [:ref :form/r]] [:ref :form/r]
  (if (or (empty-form? sigs)
          (not (or (form/is-vec? sigs) (form/is-seq? sigs) (form/is-set? sigs))))
    (invalid "signature required" (form/form-map (form/no-forms)))
    (let [n (form/count-of sigs)
          signed (kbytes/utf8-encode (if (form/is-string? manifest-cid)
                                       (form/string-value manifest-cid)
                                       ""))]
      (loop [i 0]
        (if (>= i n)
          (form/nil-form)
          (let [e (one-signature-error (form/nth-of sigs i) signed)]
            (if (form/is-nil? e) (recur (+ i 1)) e))))))))

;; ---- manifest cid ----------------------------------------------------------

#?(:kotoba
(defn manifest-without-self-cid [manifest [:ref :form/r]] [:ref :form/r]
  (let [m0 (if (form/is-map? manifest) manifest (form/form-map (form/no-forms)))
        src (gk m0 :kotoba.package/source)
        src2 (if (form/is-map? src) (form/dissoc-form src (kwf :manifest-cid)) src)]
    (form/dissoc-form (form/assoc-form m0 (kwf :kotoba.package/source) src2)
                      (kwf :kotoba.package/signatures)))))

#?(:kotoba
(defn compute-manifest-cid [manifest [:ref :form/r]] :string
  (mf/cidv1-dag-cbor (cbor/encode-form (manifest-without-self-cid manifest)))))

#?(:kotoba
(defn manifest-integrity-error [manifest [:ref :form/r]] [:ref :form/r]
  (let [declared (gk (gk manifest :kotoba.package/source) :manifest-cid)]
    (if (cid-form? declared)
      (let [computed (compute-manifest-cid manifest)]
        (if (string=? (form/string-value declared) computed)
          (form/nil-form)
          (invalid "manifest cid does not match manifest content"
                   (map2 :declared declared :computed (form/string-form computed)))))
      (form/nil-form)))))

#?(:kotoba
(defn tree-cid-error [declared [:ref :form/r] tree-bytes [:option :vector-i64]] [:ref :form/r]
  (cond
    (not (cid-form? declared)) (invalid "tree cid required" (map1 :value declared))
    (not (option-some?-of [:option :vector-i64] tree-bytes))
    (invalid "tree content required to verify tree cid" (map1 :declared declared))
    :else
    (let [computed (mf/cidv1-raw (option-value-of [:option :vector-i64] tree-bytes (vector-i64)))]
      (if (string=? (form/string-value declared) computed)
        (form/nil-form)
        (invalid "tree cid does not match tree content"
                 (map2 :declared declared :computed (form/string-form computed))))))))

;; ---- component cid -----------------------------------------------------------

#?(:kotoba
(defn component-cid-of [m [:ref :form/r]] [:ref :form/r]
  (let [a (gk m :dep/component-cid)]
    (if (truthy? a)
      a
      (let [b (gk m :kotoba.package/component-cid)]
        (if (truthy? b)
          b
          (let [c (gk (gk m :dep/build) :component-cid)]
            (if (truthy? c)
              c
              (let [d (gk (gk m :kotoba.package/build) :component-cid)]
                (if (truthy? d) d (form/nil-form)))))))))))

#?(:kotoba
(defn component-cid-error [declared [:ref :form/r] component-bytes [:option :vector-i64]] [:ref :form/r]
  (cond
    (not (cid-form? declared)) (invalid "component cid required" (map1 :value declared))
    (not (option-some?-of [:option :vector-i64] component-bytes)) (form/nil-form)
    :else
    (let [computed (mf/cidv1-raw (option-value-of [:option :vector-i64] component-bytes (vector-i64)))]
      (if (string=? (form/string-value declared) computed)
        (form/nil-form)
        (invalid "component cid does not match component content"
                 (map2 :declared declared :computed (form/string-form computed))))))))

#?(:kotoba
(defn- lock-dep-component-error [dep [:ref :form/r] component-bytes [:option :vector-i64]] [:ref :form/r]
  (let [kind (gk dep :dep/kind)
        declared (component-cid-of dep)]
    (cond
      (and (form/eq kind (kwf :component)) (form/is-nil? declared))
      (invalid "component cid required"
               (map2 :dependency (gk dep :dep/name) :kind kind))
      (not (form/is-nil? declared)) (component-cid-error declared component-bytes)
      :else (form/nil-form)))))

;; ---- package manifest ------------------------------------------------------------

#?(:kotoba
(defn- source-keys [] [:ref :form/r]
  (form/form-vec (typed-list-new [:list [:ref :form/r]]
                                 (kwf :git-commit) (kwf :tree-cid) (kwf :manifest-cid)))))

;; Check number I of `package-manifest-error`, in the host's order; nil when it holds.
#?(:kotoba
(defn- manifest-step [m [:ref :form/r] tree [:option :vector-i64] i :i64] [:ref :form/r]
  (let [source (gk m :kotoba.package/source)
        kind (gk m :kotoba.package/kind)
        pname (gk m :kotoba.package/name)]
    (cond
      (= i 0) (missing-key m (manifest-required) "missing required package field")
      (= i 1) (if (and (truthy? kind) (not (allowed-kind? kind)))
                (invalid "unknown package kind"
                         (map2 :package pname :allowed (allowed-package-kinds)))
                (form/nil-form))
      (= i 2) (contract-surfaces-error m "kotoba.package")
      (= i 3) (if (and (form/eq kind (kwf :adapter))
                       (empty-form? (gk m :kotoba.package/consumes)))
                (invalid "adapter consumes required" (map1 :package pname))
                (form/nil-form))
      (= i 4) (if (and (form/eq kind (kwf :schema-contract))
                       (empty-form? (gk m :kotoba.package/provides)))
                (invalid "schema-contract provides required" (map1 :package pname))
                (form/nil-form))
      (= i 5) (if (cid-form? (gk m :kotoba.package/repo-rid))
                (form/nil-form)
                (invalid "repo-rid cid required" (map1 :value (gk m :kotoba.package/repo-rid))))
      (= i 6) (missing-key source (source-keys) "missing required source field")
      (= i 7) (if (cid-form? (gk source :tree-cid))
                (form/nil-form)
                (invalid "tree cid required" (map1 :source source)))
      (= i 8) (if (option-some?-of [:option :vector-i64] tree)
                (tree-cid-error (gk source :tree-cid) tree)
                (form/nil-form))
      (= i 9) (if (cid-form? (gk source :manifest-cid))
                (form/nil-form)
                (invalid "manifest cid required" (map1 :source source)))
      (= i 10) (if (form/is-vec? (gk m :kotoba.package/capabilities))
                 (form/nil-form)
                 (invalid "capabilities vector required"
                          (map1 :value (gk m :kotoba.package/capabilities))))
      :else (signatures-error (gk m :kotoba.package/signatures) (gk source :manifest-cid))))))

#?(:kotoba
(defn package-manifest-error-with-tree [m [:ref :form/r] tree-bytes [:option :vector-i64]] [:ref :form/r]
  (loop [i 0]
    (if (> i 11)
      (form/nil-form)
      (let [e (manifest-step m tree-bytes i)]
        (if (form/is-nil? e) (recur (+ i 1)) e))))))

#?(:kotoba
(defn package-manifest-error [m [:ref :form/r]] [:ref :form/r]
  (package-manifest-error-with-tree m (option-none-of [:option :vector-i64]))))

;; ---- lockfile ---------------------------------------------------------------------

#?(:kotoba
(defn- signer-blocked? [s [:ref :form/r] tc [:ref :form/r]] :bool
  (or (has-member? (gk tc :revoked-signers) s)
      (has-member? (gk tc :expired-signers) s)
      (has-member? (gk tc :compromised-signers) s))))

;; The signers of SIGNERS that are blocked, each once, in the lock's order.
#?(:kotoba
(defn- blocked-signers [signers [:ref :form/r] tc [:ref :form/r]] [:ref :form/r]
  (let [n (form/count-of signers)]
    (form/form-vec
     (loop [i 0 acc (form/no-forms)]
       (if (>= i n)
         acc
         (let [s (form/nth-of signers i)]
           (recur (+ i 1)
                  (if (and (signer-blocked? s tc)
                           (not (has-member? (form/form-vec acc) s)))
                    (form/append-form acc s)
                    acc)))))))))

;; Is every item of XS a member of YS?
#?(:kotoba
(defn- subset-of? [xs [:ref :form/r] ys [:ref :form/r]] :bool
  (let [n (form/count-of xs)]
    (loop [i 0]
      (if (>= i n)
        true
        (if (has-member? ys (form/nth-of xs i)) (recur (+ i 1)) false))))))

#?(:kotoba
(defn- cid-field-error [dep [:ref :form/r] k :keyword] [:ref :form/r]
  (if (cid-form? (gk dep k))
    (form/nil-form)
    (invalid "cid required" (map2 :field (kwf k) :value (gk dep k))))))

#?(:kotoba
(defn- bytes-opt [x [:ref :form/r]] [:option :vector-i64]
  (if (form/is-bytes? x)
    (option-some-of [:option :vector-i64] (vector-i64-from-bytes (form/bytes-of x)))
    (option-none-of [:option :vector-i64]))))

;; Check number I of one lock entry, in the host's order; nil when it holds.
#?(:kotoba
(defn- dep-step [dep [:ref :form/r] tc [:ref :form/r] opts [:ref :form/r] i :i64] [:ref :form/r]
  (let [dname (gk dep :dep/name)]
    (cond
      (= i 0) (missing-key dep (lock-required) "missing required lock field")
      (= i 1) (if (and (truthy? (gk dep :dep/kind)) (not (allowed-kind? (gk dep :dep/kind))))
                (invalid "unknown package kind" (map1 :dependency dname))
                (form/nil-form))
      (= i 2) (contract-surfaces-error dep "dep")
      (= i 3) (cid-field-error dep :dep/repo-rid)
      (= i 4) (cid-field-error dep :dep/tree-cid)
      (= i 5) (cid-field-error dep :dep/manifest-cid)
      (= i 6) (definition-cids-error (gk dep :dep/definition-cids) (kwf :dep/definition-cids))
      (= i 7) (let [tb (lookup (gk opts :tree-bytes-by-dep) dname)]
                (if (truthy? tb)
                  (tree-cid-error (gk dep :dep/tree-cid) (bytes-opt tb))
                  (form/nil-form)))
      (= i 8) (lock-dep-component-error dep (bytes-opt (lookup (gk opts :component-bytes-by-dep) dname)))
      (= i 9) (if (empty-form? (gk dep :dep/signers))
                (invalid "signer required" (map1 :dep dep))
                (form/nil-form))
      (= i 10) (let [bad (blocked-signers (gk dep :dep/signers) tc)]
                 (if (empty-form? bad)
                   (form/nil-form)
                   (invalid "signer not currently trusted" (map2 :signers bad :dependency dname))))
      :else (if (subset-of? (gk dep :dep/capabilities) (gk tc :declared-capabilities))
              (form/nil-form)
              (invalid "capability grant exceeds package declaration"
                       (map2 :grant (gk dep :dep/capabilities)
                             :declared (gk tc :declared-capabilities))))))))

#?(:kotoba
(defn- dep-error [dep [:ref :form/r] tc [:ref :form/r] opts [:ref :form/r]] [:ref :form/r]
  (loop [i 0]
    (if (> i 11)
      (form/nil-form)
      (let [e (dep-step dep tc opts i)]
        (if (form/is-nil? e) (recur (+ i 1)) e))))))

#?(:kotoba
(defn- deps-error [deps [:ref :form/r] tc [:ref :form/r] opts [:ref :form/r]] [:ref :form/r]
  (let [n (form/count-of deps)]
    (loop [i 0]
      (if (>= i n)
        (form/nil-form)
        (let [e (dep-error (form/nth-of deps i) tc opts)]
          (if (form/is-nil? e) (recur (+ i 1)) e)))))))

;; OPTS: a Form map that may carry :tree-bytes-by-dep and :component-bytes-by-dep
;; ({dep-name bytes-leaf}); pass `(form/form-map (form/no-forms))` for none.
#?(:kotoba
(defn lockfile-error [m [:ref :form/r] tc [:ref :form/r] opts [:ref :form/r]] [:ref :form/r]
  (let [version (gk m :kotoba.lock/version)
        deps (gk m :deps)]
    (cond
      (not (form/eq version (form/int-form 1))) (invalid "lock version 1 required" (map1 :value version))
      (not (form/is-vec? deps)) (invalid "lock deps vector required" (map1 :value deps))
      :else (deps-error deps tc opts)))))

#?(:kotoba
(defn validate-case [tc [:ref :form/r] data [:ref :form/r]] [:ref :form/r]
  (let [kind (gk tc :type)
        result (cond
                 (form/eq kind (kwf :package-manifest)) (package-manifest-error data)
                 (form/eq kind (kwf :lockfile)) (lockfile-error data tc (form/form-map (form/no-forms)))
                 :else (invalid "unknown case type" tc))]
    (if (form/is-nil? result)
      (map1 :valid? (form/bool-form true))
      result))))
