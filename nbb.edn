;; nbb reads this file, and does NOT read deps.edn. The .cljs here are run
;; as bare `nbb <file>`, so without this they have no classpath at all --
;; including this repository's own src, which is where
;; kotoba.lang.package-contract lives.
;;
;; Every git coordinate from deps.edn is copied, not a chosen subset: the
;; namespace these scripts need pulls cbor.core in turn, and picking
;; "just the ones named in the require" left that unresolved. The Maven
;; coordinates are left out because nbb does not resolve them.
;;
;; :paths and every sha are COPIED from deps.edn, not chosen here.
{:paths ["src" "resources" "." "scripts"]
 :deps {io.github.kotoba-lang/edn {:git/sha "21cfcaefb2e66f93ea46c86c4ce8f90fef1a3843"}
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
        io.github.kotoba-lang/coll {:git/sha "563f9e8911885170a2ffb44502c2f68764b9e0a9"}
        io.github.kotoba-lang/org-ietf-cbor {:git/url "https://github.com/kotoba-lang/org-ietf-cbor.git" :git/sha "58144e81ccdf7a82367085c66ea21ca84a1a7ddb"}
        io.github.kotoba-lang/io-multiformats {:git/url "https://github.com/kotoba-lang/io-multiformats.git" :git/sha "eec3ee85c458ea830be94518b9a42f4a8f1aee40"}
        io.github.kotoba-lang/org-ietf-ed25519 {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git" :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}}}
